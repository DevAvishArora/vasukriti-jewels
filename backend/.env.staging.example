# Staging Environment Variables

NODE_ENV=staging
PORT=5000

FRONTEND_URL=https://staging.vasukritijewels.com

# MongoDB Atlas (staging cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-staging.mongodb.net/vasukriti_staging?retryWrites=true&w=majority

# JWT Secrets (different from production)
JWT_SECRET=<staging-secret>
JWT_REFRESH_SECRET=<staging-refresh-secret>
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary (staging/test account)
CLOUDINARY_CLOUD_NAME=vasukriti-staging
CLOUDINARY_API_KEY=your-staging-api-key
CLOUDINARY_API_SECRET=your-staging-api-secret

# Email Service (use Ethereal for testing)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=<ethereal-email>
EMAIL_PASS=<ethereal-password>

# Razorpay (TEST keys)
RAZORPAY_KEY_ID=rzp_test_***
RAZORPAY_KEY_SECRET=<test-secret>

LOG_LEVEL=debug
