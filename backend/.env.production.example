# Production Environment Variables
# Copy this to Render.com environment variables

NODE_ENV=production
PORT=5000

# Frontend URL (update with your domain)
FRONTEND_URL=https://vasukritijewels.com

# MongoDB Atlas (create production cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-prod.mongodb.net/vasukriti_prod?retryWrites=true&w=majority

# JWT Secrets (generate strong random strings)
# Use: openssl rand -base64 32
JWT_SECRET=<generate-strong-secret-here>
JWT_REFRESH_SECRET=<generate-strong-secret-here>
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary (production account)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Service (use real email service like SendGrid)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=<sendgrid-api-key>

# Or Gmail with App Password
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=<16-char-app-password>
# (Remove EMAIL_HOST and EMAIL_PORT for Gmail)

# Razorpay (LIVE keys)
RAZORPAY_KEY_ID=rzp_live_***
RAZORPAY_KEY_SECRET=<live-secret>

# Logging
LOG_LEVEL=info
